# Provide your Firebase Admin service-account JSON as a single-line value.
FIREBASE_SERVICE_ACCOUNT=

# Address used by browsers to reach the Socket.IO server.
VITE_SERVER_URL=http://localhost:10000

# Comma-separated browser origins accepted by the backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://echo-system-six.vercel.app
